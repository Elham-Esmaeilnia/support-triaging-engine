APP_NAME=EngineTriagingSupport
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek/deepseek-v4-flash:free

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_INDEX_PATH=data/cache/faiss.index
CACHE_STORE_PATH=data/cache/store.json

SIMILARITY_THRESHOLD=0.85
MAX_LLM_RETRIES=2
LLM_TIMEOUT_SECONDS=40
ENABLE_LLM_COMPRESSION=true
